#!/usr/bin/env bash
# Bash-compatible module environment for NOAA RDHPC Gaea (ncrc5)
# Derived from ncrc5.intel23.env, but written for bash (NOT tcsh).

set -euo pipefail

# Initialize modules (bash)
if [[ -n "${MODULESHOME:-}" && -f "${MODULESHOME}/init/bash" ]]; then
  source "${MODULESHOME}/init/bash"
else
  # Fallback commonly works on Cray systems
  source /usr/share/Modules/init/bash || true
fi

module purge || true

# Match the intent of the tcsh env file:
module unload cray-netcdf cray-hdf5 fre || true
module unload PrgEnv-pgi PrgEnv-intel PrgEnv-gnu PrgEnv-cray || true
module load PrgEnv-intel/8.6.0

module unload intel intel-classic intel-oneapi || true
module load intel-classic/2023.2.0
module load fre/bronx-23
module load cray-hdf5/1.14.3.5
module load cray-netcdf/4.9.0.17
module load libyaml/0.2.5

module unload darshan-runtime || true
module unload cray-libsci || true

echo "=== Module list ==="
module list || true
echo "=== Compiler versions ==="
ftn --version || true
cc  --version || true
